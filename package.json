{
  "name": "@v587d/capital-generation",
  "version": "2.8.3",
  "description": "Capital Generation：面向中国散户的 AI 投资助手插件(Capital mode Agent Preset）",
  "icon": "assets/cg-icon.png",
  "author": "v587d",
  "license": "MIT",
  "homepage": "https://github.com/v587d/capital-generation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/v587d/capital-generation.git"
  },
  "bugs": {
    "url": "https://github.com/v587d/capital-generation/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/runtime-entry.d.ts",
      "import": "./lib/runtime-entry.js",
      "default": "./lib/runtime-entry.js"
    },
    "./policy": {
      "types": "./lib/policy-entry.d.ts",
      "import": "./lib/policy-entry.js",
      "default": "./lib/policy-entry.js"
    },
    "./tools/chart-render": {
      "types": "./lib/chart-render-entry.d.ts",
      "import": "./lib/chart-render-entry.js",
      "default": "./lib/chart-render-entry.js"
    },
    "./tools/chart-source": {
      "types": "./lib/chart-source-entry.d.ts",
      "import": "./lib/chart-source-entry.js",
      "default": "./lib/chart-source-entry.js"
    },
    "./tools/collect": {
      "types": "./lib/collect-entry.d.ts",
      "import": "./lib/collect-entry.js",
      "default": "./lib/collect-entry.js"
    },
    "./tools/dataset-read": {
      "types": "./lib/dataset-read-entry.d.ts",
      "import": "./lib/dataset-read-entry.js",
      "default": "./lib/dataset-read-entry.js"
    },
    "./tools/ocr": {
      "types": "./lib/ocr-entry.d.ts",
      "import": "./lib/ocr-entry.js",
      "default": "./lib/ocr-entry.js"
    },
    "./tools/retrieve-search": {
      "types": "./lib/search-entry.d.ts",
      "import": "./lib/search-entry.js",
      "default": "./lib/search-entry.js"
    },
    "./tools/retrieve-sources": {
      "types": "./lib/sources-entry.d.ts",
      "import": "./lib/sources-entry.js",
      "default": "./lib/sources-entry.js"
    },
    "./tools/root-extras": {
      "types": "./lib/root-extras-entry.d.ts",
      "import": "./lib/root-extras-entry.js",
      "default": "./lib/root-extras-entry.js"
    },
    "./tools/time": {
      "types": "./lib/time-entry.d.ts",
      "import": "./lib/time-entry.js",
      "default": "./lib/time-entry.js"
    },
    "./tools/watchlist": {
      "types": "./lib/watchlist-entry.d.ts",
      "import": "./lib/watchlist-entry.js",
      "default": "./lib/watchlist-entry.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "locale",
    "chart-ui",
    "config",
    "watchlist",
    "preset",
    "selected-skills/catalog.js",
    "selected-skills/README.md",
    "selected-skills/investment-skills",
    "selected-skills/china-stock-research-skills",
    "selected-skills/InvestSkill",
    "selected-skills/peter-lynch-skill",
    "selected-skills/trading-skills",
    "selected-skills/claude-for-financial-services-cn",
    "selected-skills/financeskills",
    "selected-skills/quant-agent-skills",
    "cordis.patch.yml",
    "assets/cg-icon.png",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/capital-generation/agent.patch.yml"
      ]
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('lib', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc && node scripts/copy-assets.mjs && npm run build:client && npm run build:config-client && npm run build:watchlist-client",
    "build:client": "node scripts/build-client.mjs",
    "build:config-client": "node scripts/build-config-client.mjs",
    "build:watchlist-client": "node scripts/build-watchlist-client.mjs",
    "dev": "tsc -w",
    "vendor:charts": "node scripts/vendor-lightweight-charts.mjs",
    "check:dsh": "node scripts/check-dsh-compat.mjs",
    "demo:chart": "npm run build && node scripts/chart-demo.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build",
    "smoke:fuyao": "node scripts/smoke-fuyao.mjs",
    "smoke:wind": "node scripts/smoke-wind.mjs",
    "smoke:local-fetch": "node scripts/smoke-local-fetch.mjs",
    "contract:probe": "node scripts/contract-probe.mjs",
    "docs:capabilities": "npm run build && node scripts/gen-capability-table.mjs",
    "verify:sessions": "node scripts/verify-sessions.mjs",
    "audit:tool-errors": "node scripts/audit-tool-errors.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "lightweight-charts": "5.2.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@joplin/turndown-plugin-gfm": "^1.0.68",
    "turndown": "^7.2.4",
    "zod": "^4.5.4"
  }
}
