{
  "name": "@v587d/capital-generation",
  "version": "0.1.0",
  "description": "Capital Generation：面向中国散户的 AI 投资助手插件(Capital mode Agent Preset）",
  "author": "v587d",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "preset",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => rmSync('lib', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc",
    "dev": "tsc -w",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build",
    "smoke:fuyao": "node scripts/smoke-fuyao.mjs",
    "docs:capabilities": "npm run build && node scripts/gen-capability-table.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "js-yaml": "^5.4.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
