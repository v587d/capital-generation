{
  "id": "portfolio_stress",
  "version": "1.0.0",
  "entrypoint": "module.py",
  "runtime": "python",
  "description": "组合历史情景回放：按给定权重与已发生的窗口，逐持仓算区间收益并汇总组合收益、贡献与集中度；不预测、不评级",
  "roles": ["senior_analyst"],
  "capabilities": ["dataset.read"],
  "required_fields": [],
  "input_schema": {
    "type": "object",
    "properties": {
      "positions": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "properties": {
            "dataset_id": { "type": "string", "maxLength": 128, "description": "该持仓的价格序列 Dataset" },
            "weight": { "type": "number", "minimum": 0, "description": "权重（小数，0.25 = 25%）；所有持仓权重之和必须为 1" }
          },
          "required": ["dataset_id", "weight"],
          "additionalProperties": false
        },
        "description": "持仓列表：每个元素一份价格序列 Dataset + 权重"
      },
      "windows": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "maxLength": 64, "description": "窗口名称，如 2024-回调 / Q3-2024" },
            "start": { "type": "string", "maxLength": 10, "description": "窗口起始日 YYYY-MM-DD" },
            "end": { "type": "string", "maxLength": 10, "description": "窗口结束日 YYYY-MM-DD（含）" }
          },
          "required": ["name", "start", "end"],
          "additionalProperties": false
        },
        "description": "历史窗口列表：只回放已发生的区间，不接受未来日期"
      },
      "price_column": { "type": "string", "maxLength": 64, "description": "价格列名；省略按 close / adj_close / close_price / price / nav 识别" },
      "time_column": { "type": "string", "maxLength": 64, "description": "时间列名；省略优先用 time_coverage 列，再按 trade_date_ms / date 等识别" },
      "timezone": { "type": "string", "maxLength": 64, "description": "数值时间轴（epoch 毫秒）标注日期用的 IANA 时区；省略按 UTC" }
    },
    "required": ["positions", "windows"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["completed", "partial", "blocked", "failed"] },
      "summary": { "type": "string" },
      "metrics": { "type": "object" },
      "claims": { "type": "array" },
      "assumptions": { "type": "array" },
      "methodology_log": { "type": "array" },
      "sensitivity": { "type": "object" },
      "limitations": { "type": "array" },
      "data_gaps": { "type": "array" },
      "outputs": { "type": "array" }
    },
    "required": [
      "status", "summary", "metrics", "claims", "assumptions", "methodology_log",
      "sensitivity", "limitations", "data_gaps", "outputs"
    ],
    "additionalProperties": false
  },
  "assumptions": [
    "权重是调用方给的静态组合权重：回放期间不再平衡，也不考虑现金流出入、分红与税费",
    "组合窗口收益 = Σ 权重 × 该持仓窗口收益；持仓收益按窗口内首个与最后一个可用收盘价计算",
    "窗口是已发生的历史区间：start 必须早于 end，且两端的交易日必须落在价格序列覆盖范围内；越界写缺口，不向前/向后找替代日期",
    "集中度只用调用方权重计算（HHI = Σ w²、最大单持仓权重），与价格数据无关",
    "历史情景回放只说明这些窗口里组合会怎样；不是压力测试的假设情景，不预测、不评级，也不给仓位建议"
  ],
  "applicability": [
    "1–30 个持仓，每个持仓一份价格序列 Dataset；权重非负且合计为 1（容差 1e-6）",
    "窗口 1–12 个，日期为 YYYY-MM-DD，且全部落在数据覆盖范围内；同一窗口内所有持仓都必须有起止价格",
    "只支持多资产静态权重组合；需要动态调仓、汇率换算或期权敞口时不适用",
    "不适用于未来情景假设（用 scenario_sensitivity）、归因或业绩基准比较"
  ],
  "limits": {
    "timeout_ms": 30000,
    "max_input_rows": 200000,
    "max_output_bytes": 1048576,
    "max_log_bytes": 65536
  },
  "provenance": { "source_type": "original", "license": "MIT" }
}
