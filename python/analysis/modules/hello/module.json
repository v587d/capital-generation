{
  "id": "hello",
  "version": "1.0.0",
  "entrypoint": "module.py",
  "runtime": "python",
  "description": "分析环境自检：回显输入形状与参数，不产出任何结论",
  "roles": ["senior_analyst"],
  "capabilities": ["dataset.read", "profile.read"],
  "required_fields": [],
  "input_schema": {
    "type": "object",
    "properties": {
      "note": { "type": "string", "maxLength": 200 }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "status": { "type": "string", "enum": ["completed", "partial", "blocked", "failed"] },
      "summary": { "type": "string" },
      "metrics": { "type": "object" },
      "claims": { "type": "array" },
      "assumptions": { "type": "array" },
      "methodology_log": { "type": "array" },
      "sensitivity": { "type": "object" },
      "limitations": { "type": "array" },
      "data_gaps": { "type": "array" },
      "outputs": { "type": "array" }
    },
    "required": [
      "status", "summary", "metrics", "claims", "assumptions", "methodology_log",
      "sensitivity", "limitations", "data_gaps", "outputs"
    ],
    "additionalProperties": false
  },
  "assumptions": ["自检模块只回显输入形状，不解释数据含义"],
  "applicability": ["仅用于验证分析环境与模块协议；不要用它回答研究问题"],
  "limits": {
    "timeout_ms": 15000,
    "max_input_rows": 200000,
    "max_output_bytes": 1048576,
    "max_log_bytes": 65536
  },
  "provenance": { "source_type": "original", "license": "MIT" }
}
