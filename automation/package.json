{
  "name": "@v587d/capital-automation",
  "version": "2.14.1",
  "description": "CapGen 投研自动化：独立 host bundle（固定 capital_automation 域、单 scheduler owner、/capital-automation 路由与浏览器页面）。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "files": [
    "index.js",
    "defaults.js",
    "schema.js",
    "builtins.js",
    "time.js",
    "calendar.js",
    "calendar-source.js",
    "owner.js",
    "store.js",
    "service.js",
    "runner.js",
    "scheduler.js",
    "workspaces.js",
    "policy.js",
    "route.js",
    "settings.js",
    "redact.js",
    "client.js",
    "package.json"
  ]
}
